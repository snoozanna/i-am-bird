      <<set $captions to true>>
      <<replace "#audioMount">>
        <audio id="audioPlayer" src="assets/audio/soundcheck.mp3" autoplay>Audio is not supported on your device</audio>
        <</replace>>
        <<timed 0.2s>>
        <<replace "#testCapContainer">>
          <div id="testCaption">You can hear me.</div>
          <</replace>>
          <</timed>>

      <</link>>
      </div>
</p>
 <</append>>
<</timed>>





<<timed 8s>>
