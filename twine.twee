 <</append>>
<</timed>>

 <<timed 4s>>
  <<append "#msgMount">>
<div class="play-button-container" id="playContainer">
  <<link [img[assets/img/play-black.png]]>>
<<replace "#audioMount">>
  <audio id="audioPlayer" src="assets/audio/soundcheck.mp3" autoplay>Audio is not supported on your device</audio>
  <</replace>>
      <</link>>
      </div>
