 <</append>>
<</timed>>

 <<timed 4s>>
    <<append "#msgMount">>
      <p>To avoid attracting attention, you choose to fly under the cover of darkness.</p>
 <</append>>
<</timed>>

 <<timed 6s>>
    <<append "#msgMount">>
      <p>Look for the following symbol. It will show you the way Down the Long Wind. </p>
 <</append>>
<</timed>>

​ <<timed 8s>>
    <<append "#msgMount">>
<div class="img-container-symbol">
<img src="assets/img/3-WW.png"/>
</div>
 <</append>>
<</timed>>
 


<<timed 10s>>
    <<append "#btnContainer">>
