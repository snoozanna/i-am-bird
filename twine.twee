:: _templateChoice [nobr]
<<include "headerchoice">>
<main>

    <div id="msgMount"> </div>
    <div id="caption" class="hide"></div>
    
        <<if $pass>>
             <<set $uniqueContent to $pass+"_content">>
            <<silently>>
            <<timed 0.1s>>
            <<append "#msgMount">>
              <<include $uniqueContent>>
              <</append>>
              <</timed>>
            <</silently>>
               <div class="btn-container" id="btnContainer">
            </div>
        <<else>>
            No content provided.
        <</if>>
   
</main>

<<include "navbuttonsdir">>




:: _templateStoryTrans [nobr]
<<include "headerdir">>
<main>
<div id="audioMount">
<audio id="audio" >
  <source src="">
  <track kind="captions" srclang="en" label="English captions" id="captrack" default>
</audio>
</div>
    <div id="msgMount"> </div>
     <div class="play-button-container" id="playBtnContainer"></div>
    <div id="transcriptMount" class="hide"></div>
    
        <<if $pass>>
             <<set $uniqueContent to $pass+"_content">>
            <<silently>>
            <<timed 0.1s>>
            <<append "#msgMount">>
              <<include $uniqueContent>>
              <</append>>
              <</timed>>
            <</silently>>
               <div class="btn-container" id="btnContainer">
            </div>
        <<else>>
            No content provided.
        <</if>>
   
</main>
<<include "navbuttonstrans">>

<<done>><<set $a to setup.chooseStoryAudioNoCaps()>><</done>>

