 <p>Young birds have so many dreams.</p>
 <</append>>
<</timed>>

 <<timed 2s>>
    <<append "#msgMount">>
      <p>Will they come true for you?</p>
 <</append>>
<</timed>>

 <<timed 4s>>
  <<replace "#playBtnContainer">>
