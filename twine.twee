:: captionsbutton [nobr]

<<if $showCaptionsButton is true>>

 <<link [img[../assets/img/captions.png]]>>
      <<if $captions is true>>
           <<set $fn to setup.hideCap()>>
            <<set $captions to false>>
            <<removeclass "#msgMount" "hide">>
          <<else>>
        <<set $fn to setup.showCap()>>
         <<set $captions to true>>
          <<addclass "#msgMount" "hide">>
        <</if>>
    <</link>>
<</if>>


:: transcriptbutton [nobr]
<<if $showCaptionsButton>>
 <<link [img[../assets/img/transcript.png]]>>
      <<if $transcript is true>>
