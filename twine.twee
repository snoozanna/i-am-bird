<main>

    <div id="msgMount"> </div>
    <div id="caption" class="hide"></div>
    
        <<if $pass>>
             <<set $uniqueContent to $pass+"_content">>
            <<silently>>
            <<timed 0.1s>>
            <<append "#msgMount">>
              <<include $uniqueContent>>
              <</append>>
              <</timed>>
            <</silently>>
               <div class="btn-container" id="btnContainer">
            </div>
        <<else>>
            No content provided.
        <</if>>
   
</main>
<<include "navbuttonsdir">>




:: _templateStoryTrans [nobr]
<<include "headerdir">>
<main>
<div id="audioMount">
<audio id="audio" >
  <source src="">
  <track kind="captions" srclang="en" label="English captions" id="captrack" default>
</audio>
</div>
    <div id="msgMount"> </div>
     <div class="play-button-container" id="playBtnContainer"></div>
    <div id="transcriptMount" class="hide"></div>
    
        <<if $pass>>
             <<set $uniqueContent to $pass+"_content">>
            <<silently>>
            <<timed 0.1s>>
            <<append "#msgMount">>
              <<include $uniqueContent>>
              <</append>>
              <</timed>>
            <</silently>>
               <div class="btn-container" id="btnContainer">
            </div>
        <<else>>
            No content provided.
        <</if>>
   
</main>
<<include "navbuttonstrans">>

<<done>><<set $a to setup.chooseStoryAudioNoCaps()>><</done>>

:: welcome_1 [nobr]
<<set $prevpass to "landing">>
<<set $pass to "welcome_1">>
<<set $nextpass to "welcome_2">>
<<audio ":all" "stop">>

<<include "_templateWelcome">>

:: welcome_1_content [nobr]
 <<timed 0.1s>>
  <<replace "#msgMount">>
<p> Welcome.</p><</replace>>
<</timed>>

 <<timed 2s>>
    <<append "#msgMount">>
<p>I am Bird is an interactive storytelling experience exploring library spaces. </p>
 <</append>>
<</timed>>

 <<timed 4s>>
    <<append "#msgMount">>
<p>This mobile website will be your guide on your journey.</p>
 <</append>>
<</timed>>


 <<timed 6s>>
    <<append "#msgMount">>
<p>The following symbols will help you find your way across the library. When you see one on your screen, you will need to find the matching symbol on the library shelves. </p>
 <</append>>
<</timed>>

​ <<timed 8s>>
    <<append "#msgMount">>
<div class="img-container-symbol">
<img src="assets/img/0-Sample.png"/>
</div>
 <</append>>
<</timed>>


<<timed 10s>>
    <<append "#btnContainer">>
    <<button "Got it">>
            <<goto $nextpass>>
        <</button>>
        /* <<include "navbuttons">> */
    <</append>>
<</timed>>

:: welcome_2 [nobr]
<<set $prevpass to "welcome_1">>
<<set $pass to "welcome_2">>
<<set $nextpass to "1_story">>
<<audio ":all" "stop">>

<<include "_templateWelcome">>

:: welcome_2_content [nobr]
 <<timed 0.1s>>
  <<replace "#msgMount">>
<p>Next to each symbol, you will find a book art installation and be invited to listen to a story. </p>
<</replace>>
<</timed>>
​
 <<timed 2s>>
  <<append "#msgMount">>
<p>You can play the audio track by pressing the little triangle below. Should we test if it works?</p>
 <</append>>
<</timed>>

 <<timed 4s>>
  <<append "#msgMount">>
<div class="play-button-container">
  <<link [img[../assets/img/play.jpg]]>>

      <</link>>
      </div>
 <</append>>
<</timed>>

 <<timed 6s>>
  <<append "#msgMount">>
<p>
  You can enable or disable captions by clicking on this symbol.
  <div class="inline-icon">
    <<link [img[../assets/img/captions.png]]>>
        <<set $captions to true>>
        <<goto $pass>>
      <</link>>
      </div>
</p>
 <</append>>
<</timed>>





<<timed 8s>>
    <<append "#btnContainer">>
    <<button " It works and I’m ready to start">>
            <<goto $nextpass>>
        <</button>>
        /* <<include "navbuttons">> */
    <</append>>
<</timed>>

:: 1_story [nobr]
<<set $prevpass to "landing">>
<<set $pass to "1_story">>
<<set $nextpass to "2_dir">>
<<audio ":all" "stop">>

<<include "_templateStory">>


:: 1_story_content [nobr]

 <<timed 0.1s>>
    <<append "#msgMount">>
 <p>Welcome, dear traveller.</p>
 <</append>>
<</timed>>

 <<timed 2s>>
    <<append "#msgMount">>
      <p>This is the story of a journey.</p>
 <</append>>
<</timed>>

 <<timed 4s>>
    <<append "#msgMount">>
      <p>Your journey.</p>
 <</append>>
<</timed>>

 <<timed 6s>>
    <<append "#msgMount">>
      <p>And as bird stories go, it all starts with a nest.</p>
 <</append>>
<</timed>>
 

<<timed 8s>>
  <<replace "#playBtnContainer">>
  <<set $showCaptionsButton to true>>
    <<include "playbutton">>
  <<replace "#captionMount">>
    <<include "captionsbutton">>
    <</replace>>
 <</replace>>

<</timed>>



<<timed 90s>>
    <<append "#btnContainer">>
    <<button "Follow the light">>
            <<goto $nextpass>>
        <</button>>
    <</append>>
<</timed>>




