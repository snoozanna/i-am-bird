            <<removeclass "#msgMount" "hide">>
            <<replace "#transcriptMount">><</replace>>
            <<set $transcript to false>>
          <<else>>
         <<addclass "#msgMount" "hide">>
             <<removeclass "#transcriptMount" "hide">>
            <<replace "#transcriptMount">>
              <<include "2_transcript">>
              <</replace>>
            <<set $transcript to true>>
        <</if>>
    <</link>>
<</if>>

