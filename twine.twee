:: 2_choice [nobr]
<<set $prevpass to "2_story">>
<<set $pass to "2_choice">>
<<set $nextpass to "3_dir">>
<<audio ":all" "stop">>

<<include "_templateDir">>


:: 2_choice_content [nobr]
 <<timed 0.1s>>
    <<append "#msgMount">>
 <p>You are about to start a perilous journey.</p>
 <</append>>
<</timed>>

 <<timed 2s>>
    <<append "#msgMount">>
      <p>What do you think would make it safer?</p>
 <</append>>
<</timed>>


<<timed 4s>>
    <<append "#btnContainer">>
    <<button "Travel by day">>
          <<set $userchoices.time to "day">>
            <<goto "3_dir">>
        <</button>>
    <</append>>
<</timed>>

<<timed 5s>>
    <<append "#btnContainer">>
    <<button "Travel by night">>
      <<set $userchoices.time to "night">>
            <<goto "7_dir">>
        <</button>>
    <</append>>
<</timed>>


