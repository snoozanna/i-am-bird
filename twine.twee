:: Story JavaScript [script]
$('#ui-bar').remove();
$(document.head).find('#style-ui-bar').remove();


/* Google Tag */
setup.JSLoaded = false;
 var lockID = LoadScreen.lock();  // Lock loading screen
 importScripts("https://www.googletagmanager.com/gtag/js?id=G-TNTH69EN2L")
     .then(function() {

         setup.JSLoaded = true;
         window.dataLayer = window.dataLayer || [];
         window.gtag = function (){ dataLayer.push(arguments); };
         gtag('js', new Date());
         gtag('config', 'G-TNTH69EN2L');
          //  console.log("Sending to GA");
         LoadScreen.unlock(lockID);  // Unlock loading screen
     }).catch(function(error) {
         console.log("Error: Could not load 'gtag.js'.");
      LoadScreen.unlock(lockID);  // Unlock loading screen
     }
 );

/* Track Passage Views using SugarCube's passage display events */
$(document).on(':passagedisplay', function(ev) {
    var passageName = ev.passage.title;
    // console.log("sending", passageName, "to GA")
    // Send passage view event to Google Analytics
    if (setup.JSLoaded) {
        gtag('event', 'Passage View', {
            event_label: passageName,
            event_category: 'Passage',
        });
    }
});


 $(document).on('click', 'a', function (ev) {
 // Get the destination of the clicked link var passage 
 var passage = $(this).attr('data-passage');
 // Send the click event to Google Analytics
    if (setup.JSLoaded && passage) {
      // console.log("sending", passage, "click to GA")
        gtag('event', 'Navigation', {
            event_label: passage,
            event_category: 'GuestClick'
        });
    }
 });

// CAPTIONS

setup.addCaptions = (cuekey) =>  {
  const audio = document.getElementById("audio");
  const track = audio.addTextTrack("subtitles", "English", "en");
  track.mode = "hidden"; // since we're rendering manually

const cues = {
track_1: [[7.000,11.000,"I remember being born."],
[12.000,18.000,"They told me it’s not possible, but I do."],
[18.000,26.000,"I remember the darkness. It was hot, humid, quite claustrophobic."],
[26.000,40.000,"I remember feeling stuck. That place was too small for me. Even then, I could feel that. Even then, I knew greater things awaited."],
[40.000,50.000,"I remember hearing voices outside, they were calling me, inviting me to break free."],
[50.000,63.000,"There was an urge, deep inside my bones, to escape. To open my wings, to fly away, towards the light, towards infinity."],
[63.000,67.000,"The sky is the limit they say."],
[67.000,72.000,"So I pushed. I hit that wall as hard as I could."], 
[72.500,80.000,"And then, a little crack, and I saw it."], 
[81.000,84.000,"Freedom."]], 
track_2: [[5.000,8.500,"I’ve always known I was meant to go away."],
[9.000,18.000,"I grew up looking at the travellers. Every year in spring they were going, hundreds of them, taking over the sky."],
[18.000,23.000,"I remember asking my mom: “Can I go too?”"],
[25.000,35.000,"“Your time will come, Mawusi”, she said. “Soon enough my darling. Now eat, so you’ll be stronger.”"],
[37.000,47.000,"I remember looking at them. So free. So proud. So strong."],
[47.000,58.000,"So I ate. I did grow stronger. But I couldn’t grow fast enough for my ambition."],
[58.000,64.000,"“Why do you want to go?” Other birds asked. “Can’t you see this is the best place on earth?"],
[64.000,71.000,"Nowhere else will you find a forest so lush, a sky so blue, a water so pure..."],
[71.500,82.500,"Their sky is grey, over there, their air is cold, their water is full of oil. Don’t you know? Or maybe you just think you are better than us?”"],
[83.000,91.000,"I looked at them. They were parrots, birds of paradise, lovebirds."],
[91.000,97.500,"They were so big, so beautiful, the kings of this place. They belonged."],
[98.000,107.000,"They couldn’t understand us. They couldn’t understand that for us, leaving was surviving."],
[109.000,116.000,"There was a lone traveller living close to our nest. His name was Nunyati."],
[116.000,120.000,"He had done the journey many times, but now he was too old."],
[122.000,132.000,"I loved listening to his stories. I kept finding excuses to get close to him. He used to chase the other birds away, but I think he liked me."],
[132.000,143.000,"“You are so young, Mawusi. I used to be like you, I wouldn’t listen to anyone, I just wanted to go."],
[143.000,151.000,"But if only you knew the risks. Oh sweet child, you don’t know what’s out there."],
[151.000,162.000,"You don’t know the cold, the fear in your bones. If birds knew what awaited them, they would never leave.”"],
[162.000,166.000,"“If you had known, would you have gone anyway?”"],
[166.000,172.500,"He took a long pause, looked at the sky. He laughed."],
[173.000,181.000,"“Probably. We travellers are a mad species. It’s in our blood, we can’t fight it."],
[181.000,190.000,"Just listen to your mother, Mawusi. Eat. Grow stronger. You’ll need all the strength you can get."],
[190.000,200.000,"Your time has almost come.”"]], 
track_3: [[3.000,5.500,"And then, the day came."],
[6.000,22.000,"It had been a bright, sunny day. The sun was setting, huge against the orange sky. The forest sounds were getting quieter, ready for the night."],
[22.000,38.000,"I looked around me: I tried to memorise the colours, the smells of my homeland, I packed them all inside my brain, I stored them safely to keep myself warm during the journey."],
[38.000,44.000,"I looked at my mother’s eyes. She was proud. She was terrified."],
[44.000,50.000,"She had done the journey herself, though she had always refused to talk about it."],
[50.000,53.000,"“I’ll be fine, Ma. Don’t worry.”"],
[53.000,63.000,"“Of course you’ll be fine”, she said, then she looked away. She didn’t want me to see her doubt."],
[63.000,65.000,"I flew to the top of our tree to warm up."],
[65.000,75.000,"I looked at the open sky. It was so huge, you couldn’t see the end of it. I felt dizzy."],
[75.000,85.000,"Despite the heat, I started to shiver, my heart pounding in my chest. How could I possibly do this?"],
[85.000,97.000,"Maybe it was a big mistake. Maybe I wasn’t ready. Maybe I could wait, just a little longer."],
[97.000,106.000,"I heard a bird laugh behind me. It was a fat bird of paradise, munching on berries."],
[106.000,111.000,"“What’s up with you willow warbler? Having second thoughts?”"],
[111.000,115.000,"“I’m just stretching my wings, getting ready for the flight, that’s all.”"],
[115.000,122.000,"“No kidding. A tiny bird like you, making it to Europe? How much do you weigh? 10g?”"],
[122.000,128.000,"“8. Still, it’s not the weight that counts, it’s the spirit."],
[128.000,138.000,"But how could you understand? Birds of paradise have it easy. Big guns like you take all the food. Come summer, there will be nothing left for us."],
[138.000,147.000,"And predators are getting stronger too, they are just waiting for an opportunity to munch on the little ones too weak to escape."],
[147.000,158.000,"So don’t talk to me like I have a choice. Live or die, that’s the only choice we have. And I choose to live.“"],
[158.000,170.000,"And then, without another thought, I opened my little green wings and took off."]], 
track_4a: [[4.000,8.000,"“Follow the stars.”"],
[9.000,12.000,"I heard the voice of Nunyati in my head."],
[12.000,19.000,"“They will guide you. They have guided migrants for generations."],
[19.000,41.000,"Otherwise, don’t trust anyone. Just yourself. You are on your own now, Mawusi. We willow warblers are solo travellers. That’s the only way to be safe.”"],
[41.000,55.000,"Back then, I remember listening to him in total disbelief. How could I ever know my way in total darkness, without a map, without someone to show me the way?"],
[55.000,67.000,"I envied the sparrows, the geese, who travelled in flocks, following the older, more experienced migrants. I was alone."],
[67.000,80.000,"And yet, he was right. I realised I knew the way. Without a doubt, I trusted my ancestors’ heritage, and I flew, as fast as the wind."],
[80.000,94.000,"How could I ever describe that feeling? That sense of total freedom? That sensation that you are finally meeting your destiny? It was exhilarating. I felt invincible."],
[94.000,103.000,"I was racing into the night, further and faster than I had ever gone. Me who had never flown more than a few miles!"],
[103.000,117.000,"I saw the men’s lights beneath me, those little electric lines of roads and villages, like a spiderweb. They looked so small, so frail. You can’t catch me now, I laughed."],
[117.000,128.000,"And then, suddenly, the spiderweb stopped. There was just total darkness. A world of shadows."],
[128.000,142.000,"My heart started racing, so I decided to land on a tree at the limit of the men’s kingdom to rest. The sun was rising at the horizon. And then, I saw it."],
[142.000,154.000,"Ahead of me lay an area of unimaginable emptiness. An immense stretch of land that humans had been too terrified to conquer."],
[154.000,162.000,"And here I was, a little bird, knowing that my destiny was beneath it."],
[162.000,173.000,"The world’s greatest desert. The Sahara."]], 
track_4b: [[4.000,8.000,"“Follow your instincts.”"],
[8.000,12.000,"I heard the voice of Nunyati in my head."],
[12.000,17.000,"“When time will come, you’ll realise that you know where to go."],
[17.000,41.000,"Your ancestors have followed that path before you, it’s all there, in your DNA. Just listen to their voice. They will guide you.”"],
[41.000,47.000,"Back then, I remember listening to him in total disbelief."],
[47.000,55.000,"How could I ever know my way in total darkness, without a map, without someone to show me the way?"],
[55.000,67.000,"I envied the sparrows, the geese, who travelled in flocks, following the older, more experienced migrants. I was alone."],
[67.000,80.000,"And yet, he was right. I realised I knew the way. Without a doubt, I trusted my ancestors’ heritage, and I flew, as fast as the wind."],
[80.000,90.000,"How could I ever describe that feeling? That sense of total freedom? That sensation that you are finally meeting your destiny?"],
[90.000,94.000,"It was exhilarating. I felt invincible."],
[94.000,103.000,"I was racing into the night, further and faster than I had ever gone. Me who had never flown more than a few miles!"],
[103.000,110.000,"I saw the men’s lights beneath me, those little electric lines of roads and villages, like a spiderweb."],
[110.000,117.000,"They looked so small, so frail. You can’t catch me now, I laughed."],
[117.000,128.000,"And then, suddenly, the spiderweb stopped. There was just total darkness. A world of shadows."],
[128.000,135.000,"My heart started racing, so I decided to land on a tree at the limit of the men’s kingdom to rest."],
[135.000,142.000,"The sun was rising at the horizon. And then, I saw it."],
[142.000,154.000,"Ahead of me lay an area of unimaginable emptiness. An immense stretch of land that humans had been too terrified to conquer."],
[154.000,162.000,"And here I was, a little bird, knowing that my destiny was beneath it."],
[162.000,173.000,"The world’s greatest desert. The Sahara."]], 
track_5: [[2.000,10.000,"Eat, my darling, eat so you'll get stronger."],
[10.000,15.000,"I thought of Ma. She used to be so mad when I said I wasn’t hungry."],
[15.000,29.000,"For her, that feeling was irrelevant. The idea of not eating by choice was impossible to comprehend. When there is food, you eat, you eat as much as you can."],
[29.000,32.000,"Only then did I start to perceive how much of a blessed childhood I had."],
[33.000,43.000,"I looked at the dry dunes ahead of me and tears came to my eyes. I missed my mother."],
[43.000,47.000,"So I ate. I would make her proud."],
[47.000,49.000,"I spent a week around that village."],
[49.500,59.000,"There were other birds too. Cuckoos, warblers, nightjars. A bunch of tiny solo travellers, scared beyond belief."],
[59.000,67.000,"We kept to ourselves but secretly, we looked at each other. Which ones would make it, we wondered."],
[67.000,71.000,"We knew too well that many of us would never see the other side."],
[71.000,80.000,"Yet, none of us turned back. We just ate. Ate, ate, ate."],
[80.000,87.000,"There was enough food for all of us, so there was no need to fight."],
[88.000,96.000,"The Sahel is a blessed oasis for travellers, the last stop before the unknown."],
[96.000,102.000,"I ate and I grew. Within a week, I had doubled in size."],
[102.000,109.000,"One morning, I flew to a pond to drink and I stared at my reflection in total disbelief."],
[110.000,117.000,"“You look stunned.” An old chiffchaff was looking at me with a sarcastic face."],
[117.000,122.000,"“Sorry. It’s just that I changed so much. I can’t recognise myself.”"],
[123.000,130.000,"“Well, get used to it. You’re a migrant now. You’ll have to change much more than this when you get to the other side."],
[131.000,136.000,"Believe me, if you want to fit in, you will have to become someone else."],
[136.000,139.000,"Migrants see too much to ever remain who they were before the journey.”"],
[141.000,143.000,"“But what if I don’t want to change?”"],
[143.000,150.000,"He laughed. “Identity is a shifting concept, young lady. Soon you’ll understand.”"],
[150.000,162.000,"I looked at the Sahara. The sun was setting, covering up the dunes with a golden blanket. So beautiful, charmingly calling us to our death."],
[163.500,169.000,"But I wasn’t scared anymore. I was at peace. I was as ready as I could ever be."],
[170.000,180.000,"So I took off and followed my calling."]], 
track_6: [[3.000,12.000,"I flew West. I followed the edge of the desert, trying to find a place to cross. But it was endless."],
[12.000,16.000,"The golden dunes were laughing at me, teasing me."],
[16.000,23.000,"“Do you really think you can escape us? Do you really believe no one thought of this before?"],
[23.000,30.000,"Face your fear, little bird. There is no way around us.”"],
[30.000,43.000,"But I couldn’t face it. Not yet. That desert was too big. You couldn’t see the end of it, the sand merged with the sky in the distance, blending in infinity."],
[43.000,50.000,"“Come on, little bird, called the dunes. The dream is on the other side.”"],
[50.000,56.000,"I flew for days, refusing to give up. There must be a better way."],
[56.000,62.000,"And then, I reached the ocean. Another barrier."],
[62.000,72.000,"The Atlantic faced me with all its power, huge waves crashing on the rocks, threatening to blow me to pieces."],
[72.000,80.000,"In the distance I saw a beach, hedged with coconut trees. I landed in one of them."],
[80.000,88.000,"After days of helplessly flying over deserted plains, the lush leaves felt like a soft blanket against my body."],
[88.000,105.000,"I was so exhausted that I fell asleep almost immediately."],
[106.000,110.000,"I woke up a few hours later to a horrible cacophony."],
[110.000,118.000,"There were birds perched in all the surrounding trees, hundreds of them, singing and chittering all around me."],
[118.000,123.000,"After those weeks of lonely travel, I couldn’t face the shock."],
[123.000,128.000,"“What is this place?” I muttered to myself."],
[128.000,134.000,"“Welcome to paradise!” Shouted a big red bird, perched on the next branch."],
[134.000,138.000,"“The tropical haven for gutless birds of all horizons.”"],
[138.000,142.000,"“Why are you saying that?” I asked, defensive."],
[142.000,147.000,"“Isn’t it why you are here? This is where all migrants who can’t face the big bad desert end up."],
[147.000,153.000,"Some give up. Some eat to find the courage. Some drink to forget they have none."],
[153.000,158.000,"Would you like some coconut juice? The sugar will sweep your worries away.”"],
[158.000,161.000,"I ignored him."],
[161.000,166.000,"“Suit yourself, spoiler”, said the loud bird, and he flew away."],
[166.000,177.000,"I looked at the crowd. It was a party of birds from across the continent. They were travellers like me, and yet, I felt so alien."],
[177.000,183.000,"Maybe that red bird was right. Maybe I was just too scared to cross."],
[183.000,188.000,"Then suddenly I spotted a tiny green dot on a rock by the sea."],
[188.000,194.000,"It was another willow warbler, staring at the waves in silence."],
[194.000,200.000,"I approached him. He was probably my age, but there was something different about him."],
[200.000,207.000,"He looked stronger. His feathers looked longer, sharper. His eyes were more determined."],
[207.000,213.000,"“So you are also figuring things out, right?”, I said, to break the ice."],
[213.000,223.000,"“There is nothing to figure out”, he shrugged. “You just need to get ready. I’m flying tomorrow. Clearly, you haven’t started yet.”"],
[223.000,225.000,"“Started what?” I asked"],
[225.000,232.000,"“Moulting. Growing new feathers for the crossing. How else would you expect to do this?”"],
[232.000,236.000,"“But I thought we were only moulting after the journey…” I muttered"],
[236.000,243.000,"“Not us. We are willow warblers. How do you think small birds like us manage to cross the Sahara?"],
[243.000,252.000,"Nature knew she had to give us a hand. Look at my new feathers. Sharp, aren’t they? It’s time to get rid of yours.”"],
[252.000,257.000,"“But how?” I wondered “I’ve had these feathers since I was born.”"],
[257.000,268.000,"“Oh my darling, you’ll have to go through much bigger changes than this. You’re a migrant now. You’ll adapt. It’s our only way to survive.”"],
[268.000,277.000,"So I did. I changed. It took me two weeks. I remember weeping when I saw my first feather fall."],
[277.000,283.000,"I looked at my reflection in puddles and barely recognised myself."],
[283.000,292.000,"But alongside my feathers fell the fear. My confidence grew, with every new feather I became stronger."],
[292.000,299.000,"And then, the day came. And I was ready."]], 
track_7: [[0.000,4.000,"And then, the day came."],
[4.000,8.000,"We had been talking about it for weeks."],
[8.000,13.000,"We used to live in a colony of thirty families, on the bank of the Volta river."],
[13.500,19.000,"When I think about home, I think of a joyous crowd."],
[19.500,24.000,"I grew up surrounded by the constant chatter of my uncles and aunts."],
[24.000,34.000,"They used to pester us. The useless youth, they called us, eating, chittering and sunbathing on the riverbanks instead of getting ready."],
[34.000,42.000,"“When I was your age”, my aunt Afefa said, “I was already on my way to Europe!”"],
[42.000,46.000,"What she didn’t know is, this was our way of getting ready."],
[46.000,51.000,"As sand martins, it is our number that gives us strength."],
[51.000,59.000,"How else would you expect a 14g bird to travel across 5000 kilometres? It’s madness, when you think about it."],
[59.500,67.000,"So we chatted to boost our confidence, bragging about who would be the first to cross the desert, who would fly the highest, the fastest."],
[67.000,70.000,"We chatted to forget how terrified we were."],
[70.500,78.000,"Because we knew the odds, we knew them all too well. Three out of four of us would never see Europe."],
[79.000,85.000,"We couldn’t help looking at each other, wondering who it would be."],
[85.000,97.000,"So we made it last. We made provisions of sun, of sounds, of smells. We boosted our bodies and souls. We became stronger, as a team."],
[97.000,109.000,"Because we knew that, as much as we would miss home, we simply had no choice. We had to go."]], 
track_8: [[4.000,7.000,"I’ve been told that we sand martins talk too much."],
[7.000,12.000,"That we have no sense of privacy and that our loud constant chatter is a nuisance to other creatures."],
[13.000,21.000,"But what they don’t know is: our conversations are never pointless. Our voice can save our lives."],
[21.000,32.000,"My friends Atsu and Etse were usually chosen as vigils. They were brothers, quite small for their age, who had been selected for their powerful, piercing call."],
[32.000,48.000,"They used to perch on top of a mango tree, which offered a 360° view over the forest. From there they were on the look-out, as we had many predators, and none of them scared us so much as the hawks."],
[48.000,50.000,"We lived in a constant state of emergency."],
[52.000,56.000,"My mom had forbidden my brothers and I to venture too far from the colony."],
[56.000,64.000,"So we stayed there, apparently lazing and chatting on the riverbanks, while really, we were just waiting for the call."],
[64.000,71.000,"All it took was a high-pitched shrill, a piercing siren and in a few seconds, all birds retreated inside our bunkered nest."],
[72.000,79.000,"It was a complex network of tunnels carved inside the clay of the banks by generations of sand martins."],
[79.000,88.000,"From the openings, we could see the hawks circling around our heads. They were just biding their time."],
[88.000,96.000,"They knew that, come summer, our food supplies would be depleted, forcing us to move further and further."],
[96.000,101.000,"They knew that the summer rain would make us slower and more vulnerable."],
[101.000,112.000,"Yes, a 14g bird travelling 5000 kilometres must be mad. But staying would be even madder."],
[112.000,119.000,"On the day of departure, eighty of us joined the flock. We gathered on power lines not far from our nest."],
[119.000,124.000,"Three rows of sand martins, an army of young birds ready to conquer Europe."],
[124.000,130.000,"For once, none of us talked. We just prayed, in silence."],
[132.000,144.000,"And then, as one body, we all opened our wings and took over the blue open sky."]], 
track_9: [[3.000,9.000,"I’ve always wanted a family."],
[9.000,14.000,"I’ve always felt that urge, deep inside me."],
[14.000,18.000,"But for this, I knew migration was the only way."],
[18.000,25.000,"The summers in Ghana were harsh, humid, thousands of species were competing for the little food that was left."],
[25.000,35.000,"And how could I stand a chance, me, a 14g bird, against the turacos, the pelicans, the parrots."],
[35.000,42.000,"They were larger, faster, more powerful than us, cleverer against the predators."],
[42.000,54.000,"If I wanted a family, if I ever wanted to have something to offer them, then I had to go."],
[54.000,60.000,"Staying was looking at the past. Leaving was about the future."],
[60.000,64.000,"I had heard so many stories about the great British summers."],
[64.000,72.000,"The warm, balmy air, the late sunsets, the evergreen forests with plenty of opportunities to eat and find a mate."],
[72.000,82.000,"My friends and I used to fantasise about it, we asked our mothers and aunts to tell us all about their own journeys, how they met our fathers, our uncles."],
[82.000,90.000,"It all felt so romantic, something worth flying across two continents for."],
[90.000,97.000,"The power of love. We were young birds, we all wanted it."],
[97.000,105.000,"No matter the risks, the cold, the exhaustion, the hunger, we knew nature was calling us."],
[105.000,110.000,"It was a dream, they were sirens too powerful to escape."],
[110.000,114.000,"The greater the dangers, the greater the rewards, we thought."],
[114.000,119.000,"It was fate. It was destiny."],
[119.000,129.000,"At last, the day of departure came: there were eighty of us in our flock, eighty young lovers ready to take Europe by storm."],
[129.000,132.000,"We gathered on the branches of a mahogany tree."],
[132.000,139.000,"For once, none of us talked. We just watched the sun rise in silence."],
[139.000,150.000,"And then, as one body, we all opened our wings and took over the blue open sky."]],
track_10a: [[10.000,13.000,"How could I ever describe this feeling?"],
[13.000,20.000,"That exhilarating sense of power? That sensation that we were finally meeting our destiny."],
[20.000,26.000,"We were an army of travellers, nothing could stop us now."],
[26.000,37.000,"It was wonderful to be part of a flock, to have all eighty of us flying in the same direction, to feel we were part of something bigger, greater than ourselves."],
[37.000,45.000,"We were following the lead of the more experienced travellers, themselves following the paths of our ancestors."],
[45.000,54.000,"They took us along the Atlantic coast, a slightly longer route, but with more opportunities to rest and feed."],
[54.000,63.000,"I never thought about questioning them. It was liberating to hand over control. They had been there before, we just had to follow."],
[63.000,72.000,"I had a thought for the solo travellers, the scared little birds travelling alone under the cover of darkness. I pitied them."],
[72.000,81.000,"We didn’t have to hide, our pride carried us forward. Together, we were invincible."],
[82.000,89.000,"We watched human villages and roads beneath us. So small, so fragile."],
[89.000,95.000,"We remembered the poachers with their rifles, the children trying to catch us with nets and slingshots."],
[95.000,98.000,"Try to catch us now, we laughed."],
[98.000,105.000,"We kept pointing excitedly at human constructions, strange things most of us had never seen before."],
[105.000,109.000,"A highway. A wind turbine. A power plant."],
[109.000,113.000,"We all cheered, when we passed them by."],
[113.000,117.000,"And then, suddenly our leaders grew quiet."],
[117.000,123.000,"I looked around, and noticed that all signs of human activity had vanished."],
[123.000,131.000,"I could feel a wave of anxiety passing among the flock: we travelled in silence, our movements tense, our necks craned."],
[131.000,135.000,"We knew that we were flying towards something terrible."],
[135.000,139.000,"Something there were no words to describe."],
[139.000,142.000,"And then, we saw it."],
[142.000,146.000,"Ahead of us lay an area of unimaginable emptiness."],
[146.000,152.000,"An immense stretch of land that humans had been too terrified to conquer."],
[152.000,158.000,"The world’s greatest desert. The Sahara."]], 
track_10b:[[10.000,13.000,"How could I ever describe this feeling?"],
[13.000,20.000,"That exhilarating sense of power? That sensation that we were finally meeting our destiny."],
[20.000,26.000,"We were an army of travellers, nothing could stop us now."],
[26.000,37.000,"It was wonderful to be part of a flock, to have all eighty of us flying in the same direction, to feel we were part of something bigger, greater than ourselves."],
[37.000,45.000,"We were following the lead of the more experienced travellers, themselves following the paths of our ancestors."],
[45.000,54.000,"They made us travel North, the faster, more perilous route, in order to make it to the desert while we were still rested."],
[54.000,62.000,"I never thought about questioning them. It was liberating to hand over control. They had been there before, we just had to follow."],
[62.000,72.000,"I had a thought for the solo travellers, the scared little birds travelling alone under the cover of darkness. I pitied them."],
[72.000,80.000,"We didn’t have to hide, our pride carried us forward. Together, we were invincible."],
[80.000,89.000,"We watched human villages and roads beneath us. So small, so fragile."],
[89.000,98.000,"We remembered the poachers with their rifles, the children trying to catch us with nets and slingshots. Try to catch us now, we laughed."],
[98.000,105.000,"We kept pointing excitedly at human constructions, strange things most of us had never seen before."],
[105.000,109.000,"A highway. A wind turbine. A power plant."],
[109.000,113.000,"We all cheered, when we passed them by."],
[113.000,123.000,"And then, suddenly our leaders grew quiet. I looked around, and noticed that all signs of human activity had vanished."],
[123.000,131.000,"I could feel a wave of anxiety passing among the flock: we travelled in silence, our movements tense, our necks craned."],
[131.000,135.000,"We knew that we were flying towards something terrible."],
[135.000,139.000,"Something there were no words to describe."],
[139.000,142.000,"And then, we saw it."],
[142.000,146.000,"Ahead of us lay an area of unimaginable emptiness."],
[146.000,152.000,"An immense stretch of land that humans had been too terrified to conquer."],
[152.000,158.000,"The world’s greatest desert. The Sahara."]], 
track_11:[
  [6.000,11.000,"How did I do this? I can’t explain it."],
[11.000,19.000,"How do billions of tiny birds cross the world’s largest desert, every year, without food or water?"],
[19.000,26.000,"When humans look at our route on a map, they realise that that no sane creature would cross it."],
[26.000,31.000,"It is insane, when you think about it."],
[31.000,36.000,"So we do not think. There is no space in our bodies for thoughts."],
[36.000,45.000,"All the energy goes to the flight. Because our bodies know that, no matter how dangerous that journey is, what we leave behind is worse."],
[45.000,53.000,"And we want to live. So we fly."],
[53.000,59.000,"I flew non-stop for fifty hours. Two full days and two full nights."],
[59.000,64.000,"The night air was freezing cold, the daytime sun scorching hot."],
[64.000,72.000,"There were thousands, millions of us in the air, all moving in the same direction, racing on the most dangerous highway."],
[72.000,77.000,"Yet, during the crossing, we were alone."],
[77.000,88.000,"I crossed like I was in a dream, the adrenaline pumping through my veins, making my wings move as if they were not my own, giving me a strength I didn’t know I had."],
[88.000,94.000,"I couldn’t feel the pain, the hunger, the cold, the exhaustion."],
[94.000,103.000,"“You’re almost there”, my ancestors whispered."],
[103.000,109.000,"My mom told me it was like hatching eggs. You don’t know how you do it, nature shows you how."],
[109.000,118.000,"You just do it, and then you forget. Nobody wants to remember the pain, otherwise you wouldn’t have the strength to do it again."],
[118.000,124.000,"And then, I made it to the other side."],
[124.000,130.000,"There may have been an oasis. Or a city. I don’t remember any of it."],
[130.000,135.000,"I simply remember that I landed somewhere and I passed out."],
[135.000,142.000,"But in my dreams, I knew I was safe."]
], 
track_12:[[8.000,10.000,"Arriving in Morocco felt like a dream at first."],
[10.000,17.000,"An oasis of peace, rest and food. Oh, the food!"],
[17.000,25.000,"Now I could finally understand my mother. Why would you choose not to eat food when you know that tomorrow there may be none?"],
[25.000,33.000,"I blissfully ate and ate, greedily regrowing my strength, chatting happily with the other travellers."],
[33.000,39.000,"I was so happy that it took me a while to realise how some native birds were looking at us."],
[39.000,43.000,"The great ibises, the mighty cormorans, the graceful flamingos."],
[43.000,53.000,"They didn’t talk to us, but I could see disapproval in their eyes. I couldn’t understand why."],
[53.000,59.000,"And then one day, I was drinking by the lake when I saw a woodpecker looking at me."],
[59.000,64.000,"“Don’t you think you have overstayed your welcome?” He sneered."],
[64.000,66.000,"“What do you mean?” I asked."],
[66.000,79.000,"“You know what I mean. You are coming here in flocks, eating our food, drinking our water, taking over our woods by millions, making them dirty and unsafe. Don’t you know you are not welcome here?”"],
[79.000,84.000,"I was stunned, I didn’t know what to answer. Nobody had ever talked to me like that."],
[84.000,86.000,"Then I heard another voice behind me."],
[86.000,90.000,"“Don’t take this personally, it will happen again.”"],
[90.000,94.000,"That bird was my age, I had seen him before, but we had never spoken."],
[94.000,97.000,"“How do you know?” I asked."],
[97.000,101.000,"“I’ve done the journey once. It was tough, but you’ll get used to it, bird.”"],
[101.000,106.000,"“Don’t call me bird” I said. “My name is Mawusi.”"],
[106.000,111.000,"“Sure. That’s a nice name, but you know that nobody will ever be able to be able to pronounce it, right?"],
[111.000,115.000,"I’m Banjoko, but I got used to people calling me Bird."],
[115.000,123.000,"You’ll see, when you get there, nobody will remember your name, nobody will care if you are a swallow, a sand martin, a willow warbler."],
[123.000,125.000,"It’s all the same to them, to them you will be just another bird."],
[125.000,132.000,"I don’t think it comes from a bad place. They just don’t know foreign birds very well.”"],
[132.000,136.000,"I didn’t reply."],
[136.000,144.000,"“So” he said “I think that woodpecker was pretty clear, it seems like we have overstayed our welcome. Are you ready for the next part of the trip, Bird?”"]], 
track_13:[
  [11.000,13.000,"Arriving in Morocco felt like a dream."],
[13.000,26.000,"An oasis of peace, food and rest. I remember being so happy. So proud. I’d crossed the Sahara, man! If I could do that, I could do anything."],
[26.000,35.000,"It was wonderful to meet other travellers. There were all kinds of birds stopping in Morocco. Geese, cuckoos, swallows."],
[35.000,42.000,"We came from all over Africa. We all had different reasons to be here; we would have never talked to each other before."],
[42.000,49.000,"But the crossing had brought all us migrants together, suddenly making us feel like family."],
[49.000,56.000,"And then, one day, in the middle of that menagerie, I met Banjoko."],
[56.000,62.000,"The first time I saw him, I felt I was looking at myself in a pool of water. I was stunned."],
[62.000,67.000,"Then I stepped closer, and so did he."],
[67.000,70.000,"“Hi”, I said."],
[70.000,74.000,"How could I explain this? I felt like I knew him."],
[74.000,78.000,"When you meet birds from your own species far from home, you just click."],
[78.000,87.000,"The world around is so unsettling, so unfamiliar, that you can feel an instant connection to total strangers."],
[87.000,89.000,"“Hi Bird”, he replied."],
[89.000,92.000,"“I’m Mawusi”, I said."],
[92.000,99.000,"“Sweet. I’m Banjoko, but I got used to people calling me Bird. Nobody could pronounce my actual name.”"],
[99.000,106.000,"“So you already went to Europe, then?” “I did, once, last spring. You’ll see, you’ll never be the same after that."],
[106.000,111.000,"It’s hard to be in a place where nobody understands your name, where you are from or what you are."],
[111.000,118.000,"Where nobody can tell whether you are a swallow, a sand martin or a willow warbler. To them it’s all the same, to them you are just another bird.”"],
[118.000,125.000,"I didn’t reply. He smiled."],
[125.000,137.000,"“Don’t worry, there are good things too. And it’s easier when you travel in good company. So... would you like to join me, Bird?”"]
], 
track_14: [
  [9.000,13.000,"Travelling with Banjoko made it all feel different."],
[13.000,19.000,"Of course he was not the first bird I met on my journey; migrants rarely get privacy."],
[19.000,24.000,"But since I left home, that was the first time I felt someone truly understood me."],
[24.000,33.000,"It was nice to have somebody to talk to, to laugh with, to discuss what we would do when we made it to Europe."],
[33.000,41.000,"We had so many plans. We both really wanted to go to England, we even joked about sharing a nest one day."],
[41.000,51.000,"It felt like we had always known each other. Hardship makes you bond faster, I guess."],
[51.000,59.000,"Suddenly, I forgot why I had decided to leave home. After the Sahara, Europe was just so easy to enjoy."],
[59.000,66.000,"We travelled short distances, taking the time to eat and rest. We crossed borders, always heading North."],
[66.000,71.000,"It was a beautiful spring and there was plenty of food everywhere."],
[71.000,74.000,"We felt happy. We felt safe."],
[74.000,87.000,"Of course, we knew there were still dangers. We had heard the tales of other travellers, the stories of birds getting lost, starving to death, dying of diseases or being shot by hunters."],
[87.000,90.000,"But somehow, we believed this could not happen to us."],
[90.000,93.000,"Because together, we felt invincible."],
[93.000,101.000,"And together we were."]
], 
track_15:[
  [2.000,4.000,"We had made it to France."],
[4.000,10.000,"We knew the end of our journey was near, and our excitement grew each day."],
[10.000,17.000,"The last few weeks had changed us; we were now stronger, fitter, more adventurous in our flight."],
[17.000,24.000,"We particularly enjoyed following coastlines where we could catch the best winds to glide over the long beaches of Brittany."],
[24.000,29.000,"That’s why, at first, we didn’t worry when the wind started to rise that evening."],
[29.000,38.000,"We had been flying for about an hour. The moon was full and the waves were reflecting her light like a distorted mirror."],
[38.000,42.000,"The wind was getting stronger, but it was all a game to us."],
[42.000,46.000,"“You’re losing your balance, Bird!” Shouted Banjoko."],
[46.000,50.000,"“You wish”, I laughed, “I’ll race you to the end of that cape!”"],
[50.000,61.000,"I spread my wings and accelerated. I could hear the wind whistling in my ears and my friend calling me, trying to catch up. I raced further."],
[61.000,68.000,"Suddenly, a huge cloud covered the moon and darkness fell upon us."],
[68.000,74.000,"It started to rain heavily. Thunder was rumbling, and I couldn’t hear Banjoko anymore."],
[74.000,79.000,"I looked back, but he was nowhere to be seen."],
[79.000,86.000,"Violent gusts of wind made it hard to keep my balance. It was so dark that I couldn’t see anything."],
[86.000,89.000,"Then I heard my friend’s voice being carried by the storm."],
[89.000,97.000,"“Mawusi!” He never called me by my name. That’s how I knew how scared he was."],
[97.000,104.000,"Huge hailstones fell all around us, one hit my left wing, making me lose my balance."],
[104.000,116.000,"And then, I saw a light. A huge light, brighter than the sun, right in the middle of the night."],
[116.000,120.000,"“Am I dead?” I wondered."],
[120.000,124.000,"As I flew towards it, Nunyati’s voice echoed in my head."],
[124.000,140.000,"“Follow the stars, Mawusi. They are the only lights you can trust. Fly away from all the others, as fast as you can.”"],
[140.000,143.000,"I closed my eyes and called my friend."],
[143.000,147.000,"“Let’s land”, I screamed. I don’t think he heard me."],
[147.000,155.000,"I tried to make it to the ground, battling against the storm. I missed my landing and crashed on the beach."],
[155.000,161.000,"I dragged my battered body to a small cavity between rocks and decided to wait there."],
[161.000,171.000,"I waited all night, the wind howling around me. I was terrified."],
[171.000,178.000,"In the morning, the storm finally calmed down and I managed to go out."],
[178.000,187.000,"In front of me stood a huge concrete tower, a red and white striped giant reaching for the sky."],
[187.000,196.000,"I looked at it in awe, I had never seen anything like it before."],
[196.000,204.000,"And that’s when I noticed the tiny green shape curled up at the bottom, lifeless."],
[204.000,206.000,"My friend."],
[206.000,210.000,"Banjoko."]
], 
track_16:[[5.000,7.000,"We had crossed the French border."],
[7.000,11.000,"We knew the end of our journey was near, so we made it last."],
[11.000,19.000,"We were only flying a few hours a night, then spent the rest of the time eating and resting in pine forests."],
[19.000,30.000,"During the day, the woods were quiet: wild animals were hiding in their dens, away from the heat, while the sound of cicadas invited us to nap."],
[30.000,37.000,"It had been a beautiful day. Banjoko and I had stopped by a river to drink, then dozed off in a large pine tree."],
[37.000,42.000,"Human voices echoed in the distance, but they were too far away to worry us."],
[42.000,50.000,"The heat enhanced the forest scents, the smell of thyme, wormwood and pine needles baked by the sun."],
[50.000,65.000,"Then, I noticed another smell. Very faint at first, but unmistakable. Banjoko noticed it too. Smoke."],
[65.000,67.000,"This instantly shook us out of our slumber."],
[67.000,76.000,"Around us, I could hear the forest waking up in panic. Birds calling, crickets shrieking, foxes and wild boars stampeding across the woods."],
[76.000,83.000,"And in the distance, the crackling, snapping, popping of burning branches."],
[83.000,88.000,"Banjoko and I took off in a frenzy. But where to go?"],
[88.000,93.000,"A blanket of smoke covered everything, clouds of black fumes billowed into the sky."],
[93.000,101.000,"I was flying in a dense fog of panic, helplessly flapping my wings, unsure about what to do."],
[101.000,107.000,"“The river!” I heard Banjoko’s voice behind me. “Bird, can you find it?”"],
[107.000,110.000,"I looked for my friend, but I couldn’t see him."],
[110.000,116.000,"“Follow me”, I shouted. And I plunged towards the ground."],
[116.000,119.000,"Travelling at lower altitude was unbearable."],
[119.000,126.000,"The heat was scorching, the acrid smell of charred wood filled the air. But there was no other way."],
[126.000,136.000,"The flames raced along, twigs, branches and trunks turning into ash all around us. We could hear the pitiful cries of creatures trapped in their burrows."],
[136.000,140.000,"And then, I saw it ahead of me. The river."],
[140.000,146.000,"I raced towards it and crashed on the riverbed."],
[146.000,152.000,"My heart was racing, my lungs were scorched, but I could finally breathe."],
[152.000,158.000,"Above me, the sky was ablaze with colour. I watched in horror as the forest disintegrated before me."],
[158.000,162.000,"And then I remembered my friend."],
[162.000,164.000,"“Banjoko!” I cried."],
[164.000,170.000,"But he didn’t answer me."],
[170.000,174.000,"I was alone."]], 
track_17: [
  [4.000,7.000,"We had made it to France."],
[7.000,17.000,"Our flock had been following the Atlantic coast for weeks. Spring was blooming around us, the air was balmy, the fields green and filled with food."],
[17.000,22.000,"We knew the end of our journey was near, so we made it last."],
[22.000,28.000,"We were only travelling for a few hours a day, spending the rest of the time eating and resting on the shore."],
[28.000,35.000,"And then one day, we saw it. England."],
[35.000,42.000,"We had been flying for about an hour, when something strange appeared in the distance."],
[42.000,46.000,"It looked like a city, but there was something eerie about it."],
[46.000,59.000,"A world of green and grey, with hundreds of tiny human constructions made out of wood, plastic and fabric flapping in the wind. Almost like a ghost town."],
[59.000,64.000,"There were no trees, so we decided to land on power lines encircling the place."],
[64.000,68.000,"“What is this?” I asked Banjoko."],
[68.000,73.000,"“They call it the Jungle” replied my friend. “The last stop before England. Can you see?”"],
[74.000,76.000,"He pointed at the horizon."],
[76.000,92.000,"Behind the shadow of that strange city, beyond the ocean, I could spot it in the distance. The silhouette of a gigantic island, blurry in the morning mist, almost like a mirage. The end of our quest."],
[92.000,99.000,"Then I heard some laughter coming from below. I felt a sharp, sudden pain on my back and all went black."],
[109.000,115.000,"I woke up a few hours later to children’s voices."],
[115.000,118.000,"“Do you think it’s alive?”"],
[118.000,124.000,"Three pairs of giant, shiny black eyes stared at me from above."],
[124.000,130.000,"I tried to fly away, but thick iron bars violently hit me in the chest."],
[130.000,140.000,"I panicked. I flapped my wings, desperately trying to find a way out, but everywhere I went a metal barrier stood between me and the world."],
[140.000,142.000,"Then I heard the voice of Banjoko."],
[142.000,150.000,"“Mawusi!” He never called me by my name, that’s how I knew how scared he was."],
[150.000,159.000,"We were in a dark, covered place. There were dozens of us, a few sand martins, but also swallows, cuckoos, even one magpie."],
[159.000,165.000,"Humans had locked us all in tiny wire boxes. I was alone in mine."],
[165.000,172.000,"Suddenly, I heard a clicking sound and a huge hand entered my prison."],
[173.000,180.000,"I closed my eyes in terror, then felt five thick fingers wrapping tightly around my body."],
[180.000,189.000,"I couldn’t breathe, my heart was pounding in my chest, I thought it was the end, then all of a sudden, I saw the light."],
[189.000,200.000,"The afternoon sun blinded me completely, a fresh gust of wind ruffled my feathers and it took me a few seconds to realise I was free."],
[200.000,207.000,"There was no time to think, so I spread my wings, took off and flew to the top of a utility pole to pull myself together."],
[207.000,213.000,"On the ground, a little human girl was looking at me. She waved."],
[213.000,216.000,"“Humans. Disgusting creatures.”"],
[216.000,220.000,"I heard the disgruntled voice of one of our leaders perched on a power line next to me."],
[220.000,223.000,"“We’d better hit the road”"],
[223.000,228.000,"“But…” I muttered “My friend Banjoko is still in that tent. Surely we can…”"],
[228.000,232.000,"“My daughter is in there too”, he interrupted me with a bitter voice."],
[232.000,242.000,"“What do you want me to do about it? Risk the lives of the whole flock and lose more members? That’s the tough law of migration, kid. Just consider yourself lucky and move on.”"],
[242.500,247.000,"I froze, my eyes filled with tears."],
[247.000,257.000,"He added with a softer voice. “It is your first time. I remember how hard it felt. But believe me, time will toughen you up.”"],
[257.000,262.000,"Then without another word, he took off, and the flock followed him."]
], 
track_18: [
  [6.000,9.000,"We had made it to France."],
[9.000,16.000,"The last few weeks had changed us, we were stronger, fitter, more adventurous in our flight."],
[16.000,24.000,"Our flock was now moving in perfect synchrony, whirling in the sky and performing elaborate acrobatics."],
[24.000,32.000,"We particularly enjoyed following coastlines where we could catch the best winds to glide over the long beaches of Brittany."],
[32.000,39.000,"It had been a beautiful day. The sun was setting but our leaders decided to keep flying a little longer."],
[39.000,52.000,"The evening air was clear and balmy. Darkness gradually fell upon us, and one by one, stars lit up the sky."],
[52.000,62.000,"We were flying along majestic granite cliffs, illuminated by the moonlight. We could see our shadow cast on the white rocks."],
[62.000,69.000,"I looked at the sky, and, suddenly Nunyati’s words came back to me."],
[69.000,83.000,"“Never trust the moon, Mawusi. She’s a traitor. She’ll make you believe she’s your friend by lighting up your path, but a full moon will turn you into prey.”"],
[83.000,93.000,"I looked back, searching for Banjoko, and that’s when I noticed three large shadows flying behind ours."],
[93.000,103.000,"Our leaders noticed them too. Adrenaline awoke the flock and all eighty birds sped as one body."],
[103.000,111.000,"“Mawusi!” I heard my friend calling me. He never called me by my name; that’s how I knew he was scared."],
[111.000,114.000,"I heard the falcons shriek too. They were close."],
[114.000,121.000,"I panicked. I knew too well we couldn’t outdistance them."],
[121.000,127.000,"What chance did we have, a group of tiny sand martins against three trained hunters?"],
[127.000,134.000,"Our only hope was to compete against each other. I saw my friends realised it too."],
[134.000,144.000,"In a split second, the graceful flock was gone: all that was left was a crowd of shrieking creatures fleeing helplessly in all directions."],
[144.000,153.000,"I decided to dive towards the ocean, hoping the falcons wouldn’t follow me."],
[153.000,156.000,"They didn’t."],
[156.000,162.000,"I found a small cavity at the base of the cliff, almost at sea level. I hid there."],
[162.000,166.000,"My heart was racing, the wind was howling and the waves were crashing around me."],
[166.000,171.000,"I could hear the helpless cries of my friends in the distance."],
[171.000,178.000,"I stayed there until morning, shaking in the darkness, petrified."],
[178.000,182.000,"At sunrise, I finally dared to emerge from my shelter."],
[182.000,189.000,"I called for Banjoko, but all I could hear was my own voice echoed against the cliffs."],
[189.000,193.000,"The falcon had gone, and I was alone."],
[193.000,196.000,"I was completely alone."]
], 
track_19:[
  [4.000,10.000,"There is something about grief. It distorts time and space."],
[10.000,13.000,"I can’t tell you what happened after that day."],
[13.000,22.000,"Memories come back to me in waves, broken, scattered, unreal."],
[22.000,24.000,"I must have found a way to cross the channel."],
[24.000,28.000,"I must have found a way to make it to Britain."],
[28.000,32.000,"I probably followed other birds, though I don’t remember any of them."],
[32.000,42.000,"All I remember is, in my heart, I was alone."],
[42.000,46.000,"And then, one day, I found myself in London."],
[46.000,52.000,"After weeks of mourning, the city hit me in the face like a bad dream."],
[52.000,55.000,"I landed on a wide, crowded square."],
[55.000,61.000,"There were humans everywhere, walking in all directions, too busy to look at us."],
[61.000,67.000,"There were animals too, four giant lions, but they were made of stone."],
[67.000,73.000,"Everything was grey, the ground, the buildings, the people, the sky."],
[73.000,85.000,"Even the other birds: there were hundreds of them, fat, plump creatures perched on every monument. Clearly, they were the masters of this place."],
[85.000,92.000,"I looked around but couldn’t see any trees. Just towers of stone and glass, as high as mountains."],
[92.000,102.000,"I couldn’t breathe. The air just felt different. It had a cloudy, metallic smell. It was cold. Oh, so cold."],
[102.000,112.000,"I couldn’t understand. Was this really the Eldorado the travellers had spoken about? Had it all been a joke?"],
[112.000,121.000,"I felt dizzy. That can’t be it, I thought. I haven’t travelled across two continents for this."],
[121.000,124.000,"There must be something good about this place."],
[124.000,129.000,"There must be."]
], 
track_20:[[4.000,15.000,"“Eat, Mawusi. Food will always comfort you when everything else is lost.”"],
[15.000,28.000,"I thought of my mother. I missed her. I don’t think I had ever missed her that badly before."],
[28.000,34.000,"I felt so lonely. It is strange to feel so alone surrounded by a crowd,"],
[34.000,45.000,"But big cities have that strange quality: the larger they are, the smaller you feel. They make you feel like you don’t matter."],
[45.000,54.000,"“Eat, my sweet. Eat, and you’ll feel better.”"],
[54.000,59.000,"I looked around. In the absence of trees, I was not really spoiled for choice,"],
[59.000,63.000,"But now was not the time to be picky, I was hungry, so anything would do."],
[63.000,69.000,"I saw a tiny white worm climbing on a statue and I gulped it."],
[69.000,76.000,"“Ugh!” I heard voices behind me. “Dear me, those migrants are disgusting.”"],
[76.000,77.000,"I turned around."],
[77.000,81.000,"“What do you mean?” I asked, my mouth still full,"],
[81.000,83.000,"“And they have no manners.”"],
[83.000,88.000,"One plump grey pigeon was addressing two smaller ones, ignoring me completely."],
[88.000,98.000,"“Don’t you miss the good old days where we could feel at home here, having a peaceful luncheon undisturbed? This scene just spoiled my appetite.”"],
[98.000,101.000,"“Sorry”, I said, “I’m new here.”"],
[101.000,104.000,"“Obviously”, he sneered."],
[104.000,107.000,"“If you don’t eat worms, what do you eat, then?” I asked."],
[107.000,112.000,"“Bread, of course”, he replied haughtily. “We are civilised creatures."],
[112.000,121.000,"But I suppose there is no bread in your little jungle. No wonder you have to fall back on hunting smelly insects. How degrading.”"],
[121.000,125.000,"“Don’t be rude, Archie”, said one of the smaller pigeons."],
[125.000,132.000,"“She probably doesn’t understand us. Dooo yoouu haaave breaaad in aaa friii caaa?”"],
[132.000,143.000,"“I’m not stupid”, I said, “and of course I know bread. But that’s what humans eat. We just prefer fresh food.“ “Fresh food!”"],
[143.000,146.000,"They all laughed, mimicking me."],
[146.000,152.000,"“I don’t know why you dislike them, Rosie”, added the first pigeon. “I find those migrants amusing."],
[152.000,158.000,"But let’s head back to the Ritz, shall we? They may have disposed of the afternoon tea’s scones by now.”"],
[158.000,166.000,"And they left me there, alone in the crowd, feeling stupid with the leftovers of my first English meal."]], 
track_21:[
  [4.000,15.000,"“When you are lonely, Mawusi, look for a gang. We are stronger together.”"],
[15.000,23.000,"Nunyati had told me London was a city of travellers. A place where you could always find one of your kind."],
[23.000,38.000,"I looked around, then I noticed a large group of birds perched on the steps of the square. They seemed to know their way around and they were singing."],
[38.000,48.000,"“Sing, Mawusi. Wherever you are, singing will bring you closer to home.”"],
[48.000,55.000,"A grey dove was leading the choir, inviting passers-by to join in. I went closer."],
[55.000,59.000,"“A migrant!” Shouted a blackbird, and they all turned towards me."],
[59.000,64.000,"It was good not to feel invisible anymore."],
[64.000,66.000,"But then, I noticed the song,"],
[66.000,72.000,"“Migrants go home. Migrants go home.”"],
[72.000,79.000,"They were chanting, over and over, louder and louder. When they saw me, their excitement grew."],
[79.000,84.000,"Next to the choir, one large pigeon was addressing the crowd from a pedestal."],
[84.000,87.000,"“The Great Replacement is happening!"],
[87.000,96.000,"While you are hard at work, cuckoos from Africa are coming to your nests, kicking out your eggs to replace them by their own."],
[96.000,109.000,"And don’t think it’s only the cuckoos! Do the maths: we pigeons lay two eggs a year. A sand martin lays five eggs per season. Warblers up to nine eggs!"],
[109.000,120.000,"I’m asking you, my friends. Do you really want to live in a city you don’t recognise anymore, that has been taken over by these parasites?"],
[120.000,133.000,"Migrants take our nests, our food, our heritage. In ten years, if we don’t do anything, there will be no pigeons. Is this what you want?”"],
[133.000,136.000,"Then he looked at me. They all looked at me."],
[136.000,143.000,"I froze. They started marching in my direction, but I could not move."],
[143.000,148.000,"Their voices surrounded me, muffled, distant like in a bad dream."],
[148.000,155.000,"And then, I heard someone whispering in my ear: it was a very old crow, and she looked angry."],
[155.000,162.000,"“What are you still doing there, you idiot? Fly, birdie, fly for your life.”"],
[162.000,170.000,"So I did. I flew as fast as I could."],
[170.000,175.000,"I could still hear them behind me, they were big birds, but fear makes you faster."],
[175.000,186.000,"I flew until my wings ached, going in circles over the city, desperately trying to spot a place to hide, to find a way out in that ocean of concrete."],
[186.000,192.000,"Finally, I landed in a dark little alleyway, exhausted."],
[192.000,198.000,"It smelled like garbage, but at least it was quiet and I was alone."]
], 
track_22:[
  [7.000,10.000,"How long I stood there for, I do not know."],
[10.000,15.000,"This was so different from everything I had imagined."],
[15.000,26.000,"I remembered other travellers telling tales about London. Bright colourful tales of a grand wealthy city full of possibilities, full of travellers like me."],
[26.000,31.000,"They had made it sound so exciting, so dreamy, so welcoming."],
[31.000,39.000,"Not this cold, loud, busy place where I clearly didn’t belong."],
[39.000,48.000,"I looked at the birds around me. The crows, the blackbirds, the pigeons, the magpies… they were at home here, in a world of black and white."],
[48.000,52.000,"My green feathers made me feel so alien, I could feel everyone looking at me."],
[52.000,61.000,"The shame made my heart race: I felt so scruffy after the flight, if only I could find a place to wash?"],
[61.000,68.000,"But that big wide river looked so wild, so grey, it was as terrifying as the rest."],
[68.000,71.000,"For a moment, I thought of turning back."],
[71.000,78.000,"I toyed with that idea. Wouldn’t it be nice to see the sun again, to see my mom, my friends?"],
[78.000,82.000,"But I didn’t have the strength. Not yet."],
[82.000,92.000,"And what would I tell them? I would have to make up a story, a good story, maybe that’s what the other travellers did too."],
[92.000,104.000,"The grey pavement lay bare in front of me. Not a blade of grass. Not a leaf. Not a sign of life. Only waste left by the humans."],
[104.000,114.000,"I picked up a plastic straw. It felt strange in my beak. Strange, but strangely familiar."],
[114.000,116.000,"I examined it closely."],
[116.000,120.000,"With a bit of imagination, it could look like a twig."],
[122.000,129.000,"With a bit of imagination, maybe one could use it to build a nest."],
[129.000,135.000,"Not the kind of nest I had imagined, of course, probably a bit smaller."],
[135.000,150.000,"But with a bit of imagination, and with time, maybe one day that nest could look like home."]
], 
track_23:[[7.000,13.000,"Sand martins don’t do well alone. We are sociable creatures, it’s in our blood."],
[13.000,22.000,"This was probably the first time in my entire life I had been truly alone, and it terrified me."],
[22.000,31.000,"I looked at the grey sky, and that's when I spotted another martin flying in the distance."],
[31.000,40.000,"I called to him, but he didn’t hear me. So I took off and tried to catch up with him in the air."],
[40.000,42.000,"“Excuse me”, I gasped."],
[42.000,46.000,"He turned toward me."],
[48.000,52.000,"“Hi”, he said. “You’re new here, aren’t you?”"],
[52.000,59.000,"“How do you know?” I asked. He smiled. It was the first smile I’d got since I arrived."],
[59.000,63.000,"“Where are you going?” I asked."],
[63.000,69.000,"“The suburbs. Did you really expect to find a decent place to stay in central London?” He laughed."],
[69.000,77.000,"“Come on. I’ll show you.”"],
[79.000,82.000,"We flew for half an hour, following the river."],
[82.000,89.000,"He asked me lots of questions, about my journey, about my family, about home."],
[89.000,94.000,"You can always trust another sand martin to make you feel comfortable and have a good chat."],
[94.000,98.000,"Then suddenly, he pointed at something below on the riverbed and we landed."],
[98.000,103.000,"Ahead of me was the most terrifying nest I had ever seen."],
[103.000,110.000,"A gigantic construction of a dozen towers carved on the sandy faces of the bank, flanked by countless tiny windows."],
[110.000,120.000,"And coming in and out of those holes: sand martins. There were hundreds of them, flying around and chittering in a terrible cacophony."],
[120.000,124.000,"After the loneliness of the last few weeks, I was in shock."],
[124.000,128.000,"“What is this?” I asked my companion."],
[128.000,132.000,"“Our community”, he said. “Do you like it?”"],
[132.000,138.000,"I didn’t know what to answer. I had never seen so many birds living so close together."],
[138.000,144.000,"“Is it safe?” Was my first thought. “What if there is a fire or something?”"],
[144.000,158.000,"He shrugged. “Look, this is a migrants’ nest. Of course it’s different from what you had back home. Less spacious. Colder. But it’s a good nest. You’ll get used to it. You just need to dive in.”"],
[158.000,166.000,"And he did. He flew inside one of the openings and disappeared."],
[166.000,175.000,"I stood there, unsure about what to do. This was so different from anything I had imagined. How could this ever be home?"],
[175.000,182.000,"Then all of a sudden, I heard the voice of Nunyati in my head."],
[182.000,193.000,"“Home is an elusive concept, Mawusi. You never know where you’ll find it.”"],
[193.000,200.000,"I looked at the giant nest. I could hear the sound of dozens of sand martins coming from within, chatting, laughing."],
[201.000,206.000,"It was cold outside, it looked so much warmer inside."],
[206.000,212.000,"So I closed my eyes. I took a deep breath. And I dove in."]]
  }

  // Remove previous cues to avoid duplicates when revisiting passages
  while (track.cues.length > 0) {
    track.removeCue(track.cues[0]);
  }

  // Add new cues
  cues[cuekey].forEach(([start, end, text]) => {
    track.addCue(new VTTCue(start, end, text));
  });

  // Sync to UI caption element
  const captionBox = document.getElementById("caption");

 track.addEventListener("cuechange", () => {
  const activeCue = track.activeCues[0];
  const captionBox = document.getElementById("caption");

  if (activeCue) {
    // If new text is different, fade out first then fade in with updated text
    if (captionBox.textContent !== activeCue.text) {
      captionBox.style.opacity = "0";
      setTimeout(() => {
        captionBox.textContent = activeCue.text;
        captionBox.style.opacity = "1";
      }, 250); // matches half transition time
    }
  } else {
    captionBox.style.opacity = "0"; // fade out on silence
  }
});
};


setup.playStoryAudio = () => {
  
  const passageName = passage(); // current passage name
  const audio = document.getElementById("audioPlayer");

  if (!audio) {
    console.error("Audio element with ID 'audioPlayer' not found.");
    return;
  }

  // Reset audio element (remove prior listeners)
  audio.replaceWith(audio.cloneNode(true));
  const freshAudio = document.getElementById("audioPlayer");

  let audioFiles = [];

  // --- Passage-specific mode ---
  const passageMatch = passageName.match(/^(\d+)_/);
  if (passageMatch) {
    const num = passageMatch[1]; // extract number before underscore
    audioFiles = [`assets/audio/track_${num}.mp3`];
  }

  let currentTrack = 0;

  function playNext() {
    if (currentTrack < audioFiles.length) {
      freshAudio.src = audioFiles[currentTrack];
        console.log("playing audio", freshAudio.src )
      freshAudio.play().catch(err => {
        console.error("Audio play failed:", err);
      });
      currentTrack++;
    }
  }

  freshAudio.addEventListener("ended", playNext);

  // Start playback
  if (audioFiles.length > 0) {
    playNext();
  } else {
    console.warn("No audio files determined for this passage:", passageName);
  }
};

setup.chooseStoryAudio = () => {

  const passageName = passage(); // current passage name
  const audio = document.getElementById("audio");

  if (!audio) {
    console.error("Audio element with ID 'audioPlayer' not found.");
    return;
  }

  // Reset audio element to avoid leftover listeners
  audio.replaceWith(audio.cloneNode(true));
  const freshAudio = document.getElementById("audio");

  let audioFiles = [];

  // --- Accepts "3_intro", "4a_track", "12b_scene" ---
  const passageMatch = passageName.match(/^(\d+[a-z]?)_/i);
  if (passageMatch) {
    const key = passageMatch[1]; // e.g., "4", "4a", "12b"
    audioFiles = [`assets/audio/track_${key}.mp3`];

    // Attach matching captions (optional but logical pairing)
    setup.addCaptions(`track_${key}`);
  }

  let currentTrack = 0;

  function loadNext() {
    if (currentTrack < audioFiles.length) {
      freshAudio.src = audioFiles[currentTrack];
      freshAudio.preload = "auto";
      freshAudio.load();
      console.log("Loaded audio (not playing):", freshAudio.src);
      currentTrack++;
    }
  }

  // prepare next audio if you ever add multiple per passage
  freshAudio.addEventListener("ended", loadNext);

  // Load but DO NOT play automatically
  if (audioFiles.length > 0) {
    loadNext();
  } else {
    console.warn("No audio files determined for this passage:", passageName);
  }
};

setup.chooseStoryAudioNoCaps = () => {

  const passageName = passage(); // current passage name
  const audio = document.getElementById("audio");

  if (!audio) {
    console.error("Audio element with ID 'audioPlayer' not found.");
    return;
  }

  // Reset audio element to avoid leftover listeners
  audio.replaceWith(audio.cloneNode(true));
  const freshAudio = document.getElementById("audio");

  let audioFiles = [];

  // --- Passage-specific mode (expects format "01_intro") ---
  const passageMatch = passageName.match(/^(\d+)_/);
  if (passageMatch) {
    const num = passageMatch[1]; 
    audioFiles = [`assets/audio/track_${num}.mp3`];
  }

  let currentTrack = 0;

  function loadNext() {
    if (currentTrack < audioFiles.length) {
      freshAudio.src = audioFiles[currentTrack];
      freshAudio.preload = "auto";  // Ensure browser loads it
      freshAudio.load();            // Force buffering request
      console.log("Loaded audio (not playing):", freshAudio.src);
      currentTrack++;
    }
  }

  freshAudio.addEventListener("ended", loadNext);

  // Load but do NOT play
  if (audioFiles.length > 0) {
    loadNext();
  
  } else {
    console.warn("No audio files determined for this passage:", passageName);
  }
};

setup.play = () => {
 const audio = document.getElementById("audio")
 audio.play();
  }

setup.pause = () => {
 const audio = document.getElementById("audio")
 audio.pause();
  }

setup.showCap = () => {
    const track = document.getElementById("captrack")
    console.log("track", track)
track.mode = 'showing';
    document.getElementById("caption").style.visibility = "visible";
        document.getElementById("caption").classList.remove("hide")
  }

setup.hideCap = () => {
    const track = document.getElementById("captrack")
   track.mode = 'hidden';
    document.getElementById("caption").style.visibility = "hidden";
     document.getElementById("caption").classList.add("hide")
  }



