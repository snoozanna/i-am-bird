:: Story JavaScript [script]
$('#ui-bar').remove();
$(document.head).find('#style-ui-bar').remove();


/* Google Tag */
setup.JSLoaded = false;
 var lockID = LoadScreen.lock();  // Lock loading screen
 importScripts("https://www.googletagmanager.com/gtag/js?id=G-TNTH69EN2L")
     .then(function() {

         setup.JSLoaded = true;
         window.dataLayer = window.dataLayer || [];
         window.gtag = function (){ dataLayer.push(arguments); };
         gtag('js', new Date());
         gtag('config', 'G-TNTH69EN2L');
          //  console.log("Sending to GA");
         LoadScreen.unlock(lockID);  // Unlock loading screen
     }).catch(function(error) {
         console.log("Error: Could not load 'gtag.js'.");
      LoadScreen.unlock(lockID);  // Unlock loading screen
     }
 );

/* Track Passage Views using SugarCube's passage display events */
$(document).on(':passagedisplay', function(ev) {
    var passageName = ev.passage.title;
    // console.log("sending", passageName, "to GA")
    // Send passage view event to Google Analytics
    if (setup.JSLoaded) {
        gtag('event', 'Passage View', {
            event_label: passageName,
            event_category: 'Passage',
        });
    }
});


 $(document).on('click', 'a', function (ev) {
 // Get the destination of the clicked link var passage 
 var passage = $(this).attr('data-passage');
 // Send the click event to Google Analytics
    if (setup.JSLoaded && passage) {
      // console.log("sending", passage, "click to GA")
        gtag('event', 'Navigation', {
            event_label: passage,
            event_category: 'GuestClick'
        });
    }
 });

// CAPTIONS
setup.addCaptions = (cuekey) =>  {
    const audio = document.getElementById("audio");
     const track = audio.addTextTrack('subtitles', 'English', 'en');
    track.mode = 'showing';
    const cues = {
      track_1: [[7.02,14.82,"I remember being born. They told me it's not possible, but I do."],
[18.32,23.78,"I remember the darkness. It was hot, humid, quite claustrophobic. I remember feeling stuck. That place was too small for me. Even then, I could feel that. Even then, I knew greater things awaited."],
[40.62,46.2,"I remember hearing voices outside, they were calling me, inviting me to break free."],
[48.105,55.905,"There was an urge deep inside my bones to escape. To open my wings. To fly away towards the light, towards infinity."],
[61.665,65.385,"The sky is the limit, they say."],
[65.385,75.21,"So I pushed. I hit that wall as hard as I could, and then a little crack, and I saw it. Freedom."]], 
       cap2: [[0.001,10.444,""],[10.469,13.229,"From the beginning, our citizens just"],[13.259,15.479,"changed and became full of strange and"],[15.479,19.859,"interesting artifacts. As you walk, look"],[19.859,25.169,"around Can you see underground bars to"],[25.169,30.089,"basements of buildings? In our cities,"],[30.329,31.919,"this were quickly adapted to become"],[31.919,35.279,"places to hide from rockets. posters"],[35.279,37.019,"from Music Nights are replaced with"],[37.019,40.469,"science for bumped shelters. As food and"],[40.469,42.779,"water restart for those taking refuge,"],[43.049,45.689,"sometimes for hours, weeks, or even"],[45.689,48.719,"months. On roads such as the one you're"],[48.719,51.089,"watching, people make outposts in"],[51.089,54.059,"preparation for invasion. And artists"],[54.149,56.189,"welded giant metal beams together"],[56.219,58.589,"creating hedge hooks to stop Russian"],[58.589,62.879,"tanks. Famous churches like the one"],[62.879,66.029,"behind and the one in front of you. Were"],[66.029,67.979,"boarded up to stop the stained glass"],[67.979,72.479,"from shattering explosions. Historic"],[72.479,74.57900000000001,"Buildings were protected in unique ways"],[74.729,76.559,"using metal sheets, plywood and"],[76.559,80.489,"scaffolding. Statues similar to the many"],[80.489,82.889,"will pass on your work today. You're"],[82.889,88.589,"covered in sandbags to protect them. The"],[88.589,90.749,"air raid alarm memory from high school"],[90.749,92.699,"drills appears as a present day"],[92.699,95.57900000000001,"nightmare. You're seeing the everyday"],[95.57900000000001,98.09899999999999,"sounds of the streets, it warrants the"],[98.09899999999999,100.34899999999999,"truck it's a camera and you have minutes"],[100.34899999999999,103.469,"to get on the ground. You catch eyes"],[103.469,105.65899999999999,"with strangers in anticipation of what's"],[105.65899999999999,111.364,"to come is an airborne or theory."],[111.38900000000001,113.369,"Millions of people flee the frontline"],[113.369,116.519,"cities. men of all ages are drafted in"],[116.519,119.699,"the military and teachers cancel lessons"],[119.699,120.239,"writing"],[120.264,127.415,""],[127.44,130.02,"there will be no classes today. Stay"],[130.02,133.59,"safe, minus sirens. Go down to the"],[133.59,138.06,"shelter, pack a backpack, bandages and"],[138.09,141.81,"ID in other medications you may need a"],[141.81,145.8,"bottle of water this gets a flashlight"],[146.31,150.75,"and needle with thread money documents a"],[150.75,154.95,"power bank mobile phone write your name"],[154.95,158.1,"surname on your hand. Your blood group,"],[158.55,161.7,"relatives phone number if the explosion"],[161.7,164.94,"is close, run to the bathroom. Keep in"],[164.94,169.8,"touch, breathe deeply. These are go down"],[169.82999999999998,171.21,"in the history books."],[171.235,192.46,""]]
  }
    for (let i=0; i<cues[cuekey].length; i++){
    const cue = new VTTCue(cues[cuekey][i][0],cues[cuekey][i][1],cues[cuekey][i][2]);
    track.addCue(cue); 
}
    track.addEventListener('cuechange', () => {
    const activeCue = track.activeCues[0];
    if (activeCue) {
      document.getElementById('caption').textContent = activeCue.text;
    }
  });
  console.log(audio.track)



 
}

setup.playStoryAudio = () => {
  
  const passageName = passage(); // current passage name
  const audio = document.getElementById("audioPlayer");

  if (!audio) {
    console.error("Audio element with ID 'audioPlayer' not found.");
    return;
  }

  // Reset audio element (remove prior listeners)
  audio.replaceWith(audio.cloneNode(true));
  const freshAudio = document.getElementById("audioPlayer");

  let audioFiles = [];

  // --- Passage-specific mode ---
  const passageMatch = passageName.match(/^(\d+)_/);
  if (passageMatch) {
    const num = passageMatch[1]; // extract number before underscore
    audioFiles = [`../assets/audio/track_${num}.mp3`];
  }

  let currentTrack = 0;

  function playNext() {
    if (currentTrack < audioFiles.length) {
      freshAudio.src = audioFiles[currentTrack];
        console.log("playing audio", freshAudio.src )
      freshAudio.play().catch(err => {
        console.error("Audio play failed:", err);
      });
      currentTrack++;
    }
  }

  freshAudio.addEventListener("ended", playNext);

  // Start playback
  if (audioFiles.length > 0) {
    playNext();
  } else {
    console.warn("No audio files determined for this passage:", passageName);
  }
};

setup.chooseStoryAudio = () => {

  const passageName = passage(); // current passage name
  const audio = document.getElementById("audio");

  if (!audio) {
    console.error("Audio element with ID 'audioPlayer' not found.");
    return;
  }

  // Reset audio element to avoid leftover listeners
  audio.replaceWith(audio.cloneNode(true));
  const freshAudio = document.getElementById("audio");

  let audioFiles = [];

  // --- Passage-specific mode (expects format "01_intro") ---
  const passageMatch = passageName.match(/^(\d+)_/);
  if (passageMatch) {
    const num = passageMatch[1]; 
    audioFiles = [`../assets/audio/track_${num}.mp3`];
    setup.addCaptions(`track_${num}`)
  }

  let currentTrack = 0;

  function loadNext() {
    if (currentTrack < audioFiles.length) {
      freshAudio.src = audioFiles[currentTrack];
      freshAudio.preload = "auto";  // Ensure browser loads it
      freshAudio.load();            // Force buffering request
      console.log("Loaded audio (not playing):", freshAudio.src);
      currentTrack++;
    }
  }

  freshAudio.addEventListener("ended", loadNext);

  // Load but do NOT play
  if (audioFiles.length > 0) {
    loadNext();
  
  } else {
    console.warn("No audio files determined for this passage:", passageName);
  }
};

setup.chooseStoryAudioNoCaps = () => {

  const passageName = passage(); // current passage name
  const audio = document.getElementById("audio");

  if (!audio) {
    console.error("Audio element with ID 'audioPlayer' not found.");
    return;
  }

  // Reset audio element to avoid leftover listeners
  audio.replaceWith(audio.cloneNode(true));
  const freshAudio = document.getElementById("audio");

  let audioFiles = [];

  // --- Passage-specific mode (expects format "01_intro") ---
  const passageMatch = passageName.match(/^(\d+)_/);
  if (passageMatch) {
    const num = passageMatch[1]; 
    audioFiles = [`../assets/audio/track_${num}.mp3`];
  }

  let currentTrack = 0;

  function loadNext() {
    if (currentTrack < audioFiles.length) {
      freshAudio.src = audioFiles[currentTrack];
      freshAudio.preload = "auto";  // Ensure browser loads it
      freshAudio.load();            // Force buffering request
      console.log("Loaded audio (not playing):", freshAudio.src);
      currentTrack++;
    }
  }

  freshAudio.addEventListener("ended", loadNext);

  // Load but do NOT play
  if (audioFiles.length > 0) {
    loadNext();
  
  } else {
    console.warn("No audio files determined for this passage:", passageName);
  }
};

setup.play = () => {
 const audio = document.getElementById("audio")
 audio.play();
  }

setup.pause = () => {
 const audio = document.getElementById("audio")
 audio.pause();
  }

setup.showCap = () => {
    const track = document.getElementById("captrack")
    console.log("track", track)
track.mode = 'showing';
    document.getElementById("caption").style.visibility = "visible";
        document.getElementById("caption").classList.remove("hide")
  }

setup.hideCap = () => {
    const track = document.getElementById("captrack")
   track.mode = 'hidden';
    document.getElementById("caption").style.visibility = "hidden";
     document.getElementById("caption").classList.add("hide")
  }



